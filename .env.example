# Salin file ini menjadi ".env" lalu isi nilainya dari Firebase Console
# (Project settings > General > Your apps > SDK setup and configuration).
# ".env" tidak di-commit. Di Railway, isi nama-nama yang sama di tab Variables.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_DATABASE_URL=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# Opsional (hanya untuk Google Analytics, belum dipakai aplikasi)
FIREBASE_MEASUREMENT_ID=
